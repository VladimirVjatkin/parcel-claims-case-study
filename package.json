{
  "name": "mailstep-reklamace-case-study",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Case study Mailstep: rozhodovací logika pro zakládání reklamací a čtení tracking stránek",
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "decide": "tsx src/cli/decide.ts --out reports/rozhodnuti.md",
    "eval": "tsx src/cli/evaluate.ts --out reports/mereni.md",
    "all": "npm run typecheck && npm test && npm run decide && npm run eval"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
